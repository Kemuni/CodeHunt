PROJECT_NAME="CodeHunt"

# PostgreSQL для локального backend; в Docker адрес задаёт compose.
POSTGRES_DB=CodeHuntDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_PORT=5433
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# MinIO для локальной разработки. Compose автоматически создаёт приватный бакет.
MINIO_ROOT_USER=codehunt
MINIO_ROOT_PASSWORD=codehunt-local-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL="http://localhost:${MINIO_PORT}"
S3_ACCESS_KEY="${MINIO_ROOT_USER}"
S3_SECRET_KEY="${MINIO_ROOT_PASSWORD}"
S3_BUCKET=codehunt

# Максимальный размер одной фотографии задания, в байтах.
MAX_PHOTO_BYTES=5242880
# Кешировать только небольшие файлы; остальные выдавать потоком.
MEDIA_CACHE_MAX_BYTES=1048576

NEXT_PUBLIC_API_URL="http://localhost:8000"

# GitHub OAuth: одинаковое приложение для frontend и backend.
GITHUB_ID=change-me
GITHUB_SECRET=change-me
# Подтверждённые email администраторов через запятую. Пустой список — нет админов.
ADMIN_EMAILS=
