
# https://github.com/settings/apps and go to "Oauth Apps"
# Callback URL в GitHub OAuth App: http://localhost:3000/api/auth/callback/github
GITHUB_ID=сhange-me
GITHUB_SECRET=сhange-me

# Случайный секрет для зашифрованной cookie: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000
# Внутренний адрес backend для серверных запросов Next.js.
BACKEND_API_URL=http://127.0.0.1:8000
